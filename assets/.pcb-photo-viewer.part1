(() => {
  if (!window.THREE) return;
  const THREE = window.THREE;

  const clamp = THREE.MathUtils.clamp;
  const deg = THREE.MathUtils.degToRad;

  const roundedRectShape = (w, h, r) => {
    const x = -w / 2, y = -h / 2;
    const rr = Math.max(0, Math.min(r || 0, w / 2, h / 2));
    const s = new THREE.Shape();
    if (!rr) {
      s.moveTo(x, y); s.lineTo(x + w, y); s.lineTo(x + w, y + h); s.lineTo(x, y + h); s.closePath();
      return s;
    }
    s.moveTo(x + rr, y);
    s.lineTo(x + w - rr, y); s.quadraticCurveTo(x + w, y, x + w, y + rr);
    s.lineTo(x + w, y + h - rr); s.quadraticCurveTo(x + w, y + h, x + w - rr, y + h);
    s.lineTo(x + rr, y + h); s.quadraticCurveTo(x, y + h, x, y + h - rr);
    s.lineTo(x, y + rr); s.quadraticCurveTo(x, y, x + rr, y); s.closePath();
    return s;
  };

  const makeSurfaceGeometry = (w, h, radius, bottom = false) => {
    const shape = roundedRectShape(w, h, radius);
    const g = new THREE.ShapeGeometry(shape, 24);
    const pos = g.getAttribute('position');
    const uv = new Float32Array(pos.count * 2);
    for (let i = 0; i < pos.count; i += 1) {
      const x = pos.getX(i), y = pos.getY(i);
      uv[i * 2] = (x + w / 2) / w;
      const vTop = (y + h / 2) / h;
      uv[i * 2 + 1] = bottom ? vTop : 1 - vTop;
    }
    g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));
    g.rotateX(-Math.PI / 2);
    if (bottom) g.rotateY(Math.PI);
    return g;
  };

  const loadTexture = (url, renderer) => new Promise((resolve, reject) => {
    new THREE.TextureLoader().load(url, (texture) => {
      texture.encoding = THREE.sRGBEncoding;
      texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
      texture.minFilter = THREE.LinearMipmapLinearFilter;
      texture.magFilter = THREE.LinearFilter;
      resolve(texture);
    }, undefined, reject);
  });

  const canvasTexture = (canvas, renderer) => {
    const texture = new THREE.CanvasTexture(canvas);
    texture.encoding = THREE.sRGBEncoding;
    texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
    texture.minFilter = THREE.LinearMipmapLinearFilter;
    texture.magFilter = THREE.LinearFilter;
    texture.needsUpdate = true;
    return texture;
  };

  const loadImage = (url) => new Promise((resolve, reject) => {
    const image = new Image(); image.decoding = 'async'; image.onload = () => resolve(image); image.onerror = reject; image.src = url;
  });

  const projectiveCanvas = async ({ url, sourceWidth, sourceHeight, inverseHomography, size = 1024 }) => {
    const image = await loadImage(url);
    const src = document.createElement('canvas'); src.width = sourceWidth; src.height = sourceHeight;
    const sctx = src.getContext('2d', { willReadFrequently: true }); sctx.drawImage(image, 0, 0, sourceWidth, sourceHeight);
    const source = sctx.getImageData(0, 0, sourceWidth, sourceHeight).data;
    const out = document.createElement('canvas'); out.width = size; out.height = size;
    const octx = out.getContext('2d'); const target = octx.createImageData(size, size); const dst = target.data;
    const h = inverseHomography;
    for (let y = 0; y < size; y += 1) {
      const py = (y / (size - 1)) * 1200;
      for (let x = 0; x < size; x += 1) {
        const px = (x / (size - 1)) * 1200;
        const q = h[6] * px + h[7] * py + h[8];
        const sx = (h[0] * px + h[1] * py + h[2]) / q;
        const sy = (h[3] * px + h[4] * py + h[5]) / q;
        const ix = Math.max(0, Math.min(sourceWidth - 1, Math.round(sx)));
        const iy = Math.max(0, Math.min(sourceHeight - 1, Math.round(sy)));
        const si = (iy * sourceWidth + ix) * 4, di = (y * size + x) * 4;
        dst[di] = source[si]; dst[di + 1] = source[si + 1]; dst[di + 2] = source[si + 2]; dst[di + 3] = 255;
      }
    }
    octx.putImageData(target, 0, 0); return out;
  };

  const stitchedCanvas = async ({ width, height, layers }) => {
    const canvas = document.createElement('canvas'); canvas.width = width; canvas.height = height;
    const ctx = canvas.getContext('2d'); ctx.fillStyle = '#070808'; ctx.fillRect(0, 0, width, height);
    for (const layer of layers) {
      const image = await loadImage(layer.url);
      ctx.save(); ctx.globalAlpha = layer.alpha == null ? 1 : layer.alpha;
      ctx.drawImage(image, layer.sx, layer.sy, layer.sw, layer.sh, layer.dx, layer.dy, layer.dw, layer.dh);
